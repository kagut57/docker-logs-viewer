# Copy to config.env (start.sh does this on first run), edit, then run: sudo bash start.sh

# Port the viewer listens on
PORT=6060

# Login for the web UI. Leave AUTH_PASS empty to have start.sh generate a random one.
AUTH_USER=admin
AUTH_PASS=

# Custom domain, e.g. logs.example.com
# Point its DNS A record at this server's IP first. When set, start.sh will:
#   - check the domain resolves to this server
#   - install nginx as a reverse proxy
#   - get a free Let's Encrypt certificate with certbot (auto-renewing)
#   - bind the app to 127.0.0.1 so it is only reachable through the domain
DOMAIN=

# Email for Let's Encrypt expiry notices (optional)
CERTBOT_EMAIL=

# Set to false to serve the domain over plain HTTP only (no certificate)
DOMAIN_HTTPS=true

# Public HTTPS port for the domain (port 80 is always needed for certificate checks)
HTTPS_PORT=443

# Set to true to skip the "domain points to this server" check (e.g. behind Cloudflare proxy)
SKIP_DNS_CHECK=false

# Address the app binds to. Empty = 127.0.0.1 when DOMAIN is set, otherwise 0.0.0.0
HOST=

# Max lines kept in the browser per container (oldest lines are dropped beyond this)
MAX_LINES=100000
